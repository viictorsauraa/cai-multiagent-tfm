# Generic fallback used by CAI outside the orchestrated patterns.
CAI_MODEL=llama3.3:latest

# Red Team multi-agent model assignment. These values override the pattern
# defaults and let each role use a model suited to its workload.
CAI_ORCH_MODEL=qwen2.5:72b
CAI_RECON_MODEL=qwen3:14b
CAI_STRATEGY_MODEL=qwen2.5:72b
CAI_EXPLOIT_MODEL=qwen2.5:32b
CAI_PRIVESC_MODEL=qwen2.5:32b
CAI_REPORT_MODEL=qwen3:14b

CAI_GUARDRAILS=false

# OpenAI-compatible endpoint exposed by the Ollama server.
OLLAMA_API_BASE=http://<HOST>:11434/v1
OLLAMA_API_KEY=ollama

# Cloud-provider credentials are optional when all models run through Ollama.
OPENAI_API_KEY="sk-1234"
ANTHROPIC_API_KEY=""
PROMPT_TOOLKIT_NO_CPR=1
CAI_STREAM=false
